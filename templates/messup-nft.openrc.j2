#!/sbin/openrc-run
# Managed by Ansible — do not edit manually

description="messup nft port-forward (oneshot apply)"

depend() {
	need net
	after firewall
}

start() {
	ebegin "Applying messup nft NAT"
	if [ ! -f "{{ nft_install_dir }}/rules.nft" ]; then
		eerror "rules not found: {{ nft_install_dir }}/rules.nft"
		eend 1
		return 1
	fi
	nft -f "{{ nft_install_dir }}/rules.nft"
	eend $?
}

stop() {
	ebegin "Removing messup nft table"
	if nft list table ip forward >/dev/null 2>&1; then
		nft delete table ip forward
	fi
	eend 0
}
